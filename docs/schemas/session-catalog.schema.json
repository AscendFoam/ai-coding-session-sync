{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-session-sync.local/schemas/session-catalog.schema.json",
  "title": "AISS Desktop Session Catalog",
  "description": "Draft schema for the desktop session-library catalog payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "sessions",
    "projects",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "examples": [
        "0.1.0"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectSummary"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "tool": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]+-(all|codex|claude)$"
    },
    "latestState": {
      "type": "string",
      "enum": [
        "ready",
        "conflict",
        "missing",
        "not-applicable"
      ]
    },
    "patchReplayState": {
      "type": "string",
      "enum": [
        "ready",
        "blocked",
        "missing",
        "unavailable",
        "none",
        "not-applicable"
      ]
    },
    "countByTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "claude"
      ],
      "properties": {
        "codex": {
          "type": "integer",
          "minimum": 0
        },
        "claude": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dirty",
        "patch",
        "conflict",
        "warning"
      ],
      "properties": {
        "dirty": {
          "type": "integer",
          "minimum": 0
        },
        "patch": {
          "type": "integer",
          "minimum": 0
        },
        "conflict": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_key",
        "tool",
        "source_kind",
        "native_session_id",
        "title",
        "native_title",
        "project_id",
        "project_label",
        "updated_at",
        "transcript_path",
        "cwd",
        "score",
        "score_reasons",
        "goal_candidate",
        "excerpt_count",
        "total_excerpt_count",
        "total_user_count",
        "total_assistant_count",
        "latest_state",
        "has_handoff",
        "has_patch",
        "patch_replay_state",
        "status_flags"
      ],
      "properties": {
        "session_key": {
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "source_kind": {
          "type": "string"
        },
        "native_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "transcript_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": "integer"
        },
        "score_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal_candidate": {
          "type": [
            "string",
            "null"
          ]
        },
        "excerpt_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_excerpt_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_user_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_assistant_count": {
          "type": "integer",
          "minimum": 0
        },
        "latest_state": {
          "$ref": "#/$defs/latestState"
        },
        "latest_snapshot_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]+-(all|codex|claude)$"
        },
        "has_handoff": {
          "type": "boolean"
        },
        "has_patch": {
          "type": "boolean"
        },
        "patch_replay_state": {
          "$ref": "#/$defs/patchReplayState"
        },
        "status_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "projectSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "display_name",
        "session_count",
        "tool_counts",
        "latest_updated_at",
        "roots"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "tool_counts": {
          "$ref": "#/$defs/countByTool"
        },
        "latest_updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_sessions",
        "total_projects",
        "tool_counts",
        "status_counts"
      ],
      "properties": {
        "total_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "total_projects": {
          "type": "integer",
          "minimum": 0
        },
        "tool_counts": {
          "$ref": "#/$defs/countByTool"
        },
        "status_counts": {
          "$ref": "#/$defs/statusCounts"
        }
      }
    }
  }
}
