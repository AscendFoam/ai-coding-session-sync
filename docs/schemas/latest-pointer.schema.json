{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-session-sync.local/schemas/latest-pointer.schema.json",
  "title": "AI Coding Session Sync Latest Pointer",
  "description": "Draft schema for latest/*.json snapshot pointer files.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "manifest"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]+-(all|codex|claude)$"
        },
        "manifest": {
          "type": "string",
          "pattern": "^manifests/.+\\.json$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "requires_selection"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]+-(all|codex|claude)$"
          }
        },
        "requires_selection": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      }
    }
  ]
}
