{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-session-sync.local/schemas/project-catalog.schema.json",
  "title": "AISS Desktop Project Catalog",
  "description": "Draft schema for the desktop project catalog payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "projects",
    "summary",
    "selected_project"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "examples": [
        "0.1.0"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "selected_project": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "project_id",
        "display_name",
        "roots",
        "git_remote",
        "branch",
        "head",
        "session_count",
        "active_tools",
        "latest_snapshot_ids",
        "latest_conflicts",
        "sessions",
        "recommended_session_key"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "git_remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "active_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "latest_snapshot_ids": {
          "$ref": "#/$defs/latestSnapshotIds"
        },
        "latest_conflicts": {
          "$ref": "#/$defs/latestConflicts"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectSession"
          }
        },
        "recommended_session_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]+-(all|codex|claude)$"
    },
    "countByTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "claude"
      ],
      "properties": {
        "codex": {
          "type": "integer",
          "minimum": 0
        },
        "claude": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "latestSnapshotIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "claude"
      ],
      "properties": {
        "codex": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]+-(all|codex|claude)$"
        },
        "claude": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]+-(all|codex|claude)$"
        }
      }
    },
    "latestConflicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "claude"
      ],
      "properties": {
        "codex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshotId"
          }
        },
        "claude": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshotId"
          }
        }
      }
    },
    "projectSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_key",
        "tool",
        "title",
        "updated_at",
        "goal_candidate",
        "score",
        "status_flags"
      ],
      "properties": {
        "session_key": {
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "goal_candidate": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": "integer"
        },
        "status_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "display_name",
        "roots",
        "git_remote",
        "branch",
        "head",
        "session_count",
        "active_tools",
        "latest_snapshot_ids",
        "latest_conflicts",
        "sessions",
        "recommended_session_key"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "git_remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "active_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "latest_snapshot_ids": {
          "$ref": "#/$defs/latestSnapshotIds"
        },
        "latest_conflicts": {
          "$ref": "#/$defs/latestConflicts"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectSession"
          }
        },
        "recommended_session_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_projects",
        "total_sessions",
        "tool_counts",
        "latest_conflict_count"
      ],
      "properties": {
        "total_projects": {
          "type": "integer",
          "minimum": 0
        },
        "total_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "tool_counts": {
          "$ref": "#/$defs/countByTool"
        },
        "latest_conflict_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
